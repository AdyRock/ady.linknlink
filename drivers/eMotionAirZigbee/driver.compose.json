{
	"name": {
		"en": "eMotion Air (Zigbee)"
	},
	"class": "sensor",
	"platforms": [
		"local"
	],
	"connectivity": [
		"zigbee"
	],
	"capabilities": [
		"alarm_presence",
		"measure_temperature",
		"measure_humidity",
		"measure_luminance",
		"measure_battery"
	],
	"settings": [
		{
			"id": "temperature_min_change",
			"type": "number",
			"label": {
				"en": "Temperature minimum change before reporting"
			},
			"hint": {
				"en": "The minimum temperature change required before the sensor sends a new report. WARNING: Low values can drain the battery faster."
			},
			"value": 1,
			"min": 0.1,
			"step": 0.1,
			"units": {
				"en": "°C"
			}
		},
		{
			"id": "humidity_min_change",
			"type": "number",
			"label": {
				"en": "Humidity minimum change before reporting"
			},
			"hint": {
				"en": "The minimum relative humidity change required before the sensor sends a new report. WARNING: Low values can drain the battery faster."
			},
			"value": 1,
			"min": 0.1,
			"step": 0.1,
			"units": {
				"en": "%"
			}
		}
	],
	"energy": {
		"batteries": [
			"AAA",
			"AAA",
			"AAA"
		]
	},
	"zigbee": {
		"manufacturerName": "LinknLink",
		"productId": "eMotion Air",
		"endpoints": {
			"1": {
				"clusters": [
					0,
					1,
					3,
					1024,
					1026,
					1029,
					1030
				],
				"bindings": [
					1,
					6,
					8,
					1024,
					1026,
					1029,
					1030
				]
			}
		},
		"learnmode": {
			"instruction": {
				"en": "Press and hold the eMotion Air button to enter Zigbee pairing mode."
			}
		}
	},
	"icon": "{{driverAssetsPath}}/icon.svg",
	"images": {
		"large": "{{driverAssetsPath}}/images/large.jpg",
		"small": "{{driverAssetsPath}}/images/small.jpg"
	}
